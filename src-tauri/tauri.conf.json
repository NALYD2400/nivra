{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nivra",
  "version": "0.1.1",
  "identifier": "fr.quota.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1438",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Nivra",
        "decorations": false,
        "width": 920,
        "height": 700,
        "minWidth": 650,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "useLocalToolsDir": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDExNUVDOTk5MTA1NUJFOEMKUldTTXZsVVFtY2xlRWE4QlByc2FzTHdCdGRrYjJRc0hEaGVMSmphd2hyd2V6U0x0OGVpaEZ5ajYK",
      "endpoints": [
        "https://github.com/NALYD2400/nivra/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
